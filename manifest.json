{
  "manifest_version": 3,
  "name": "Telegram Message Exporter",
  "version": "1.0.0",
  "description": "Export numbered messages from Telegram Web chats, groups, and channels.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://web.telegram.org/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}